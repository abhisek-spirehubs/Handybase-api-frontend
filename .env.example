# Handybase example environment file
# Copy this to `.env` and fill in real values. Do NOT commit real secrets to source control.

# App
APP_NAME=HandybaseAPI
ENV=local            # local | staging | production
DEBUG=true           # true for local dev

# Database (MongoDB)
DATABASE_NAME=handybase
# Example URI formats:
# - MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
# - Self-hosted: mongodb://<user>:<pass>@host:27017/<dbname>
MONGO_URI=mongodb+srv://<DB_USER>:<DB_PASS>@cluster0.example.mongodb.net/<DB_NAME>

# JWT
JWT_SECRET=your_jwt_secret_here_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - a JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# File uploads
ENABLE_UPLOADS=false
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-username@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Handybase <no-reply@example.com>"

# Redis (optional) - used by rate limiter
# REDIS_URL=redis://localhost:6379
